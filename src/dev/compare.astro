---
import "../styles/global.css";
import { examples } from "../components/examples/registry";
import { Font } from "astro:assets";

const identities = [
  { value: "nasa", label: "Modern NASA" },
  { value: "editorial", label: "Editorial" },
  { value: "neobrutalism", label: "Neobrutalism" },
];
const modes = ["light", "dark", "system"];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Compare identities</title>
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-bricolage-grotesque" preload />
    <Font cssVariable="--font-junicode" preload />
  </head>
  <body class="compare">
    <header class="compare-bar">
      <h1>Compare identities</h1>
      <fieldset class="compare-modes">
        <legend>Color mode</legend>
        {
          modes.map((mode) => (
            <label>
              <input
                type="radio"
                data-compare-mode
                name="mode"
                value={mode}
                checked={mode === "light"}
              />
              {mode}
            </label>
          ))
        }
      </fieldset>
    </header>
    <div class="compare-scroll">
      <div class="compare-grid">
        {
          identities.map((identity) => (
            <h2 class="compare-heading">{identity.label}</h2>
          ))
        }
        {
          examples.map((example) => (
            <>
              <div class="compare-caption">
                <h3>{example.title}</h3>
                <p>{example.description}</p>
              </div>
              {identities.map((identity) => (
                <div
                  class="compare-cell compare-cell-stacked"
                  data-identity={identity.value}
                  data-theme="light"
                  data-compare-cell
                >
                  <example.Component />
                </div>
              ))}
            </>
          ))
        }
      </div>
    </div>

    <script>
      import { initializeComponents } from "../scripts/component-runner";

      initializeComponents(document);
      const cells = document.querySelectorAll<HTMLElement>(
        "[data-compare-cell]",
      );

      const inputModes =
        document.querySelectorAll<HTMLInputElement>("[data-compare-mode]");

      for (const inputMode of inputModes) {
        inputMode.addEventListener("change", () => {
          for (const cell of cells) {
            cell.dataset.theme = inputMode.value;
            const themeOptions = cell.querySelectorAll<HTMLInputElement>(
              "[data-theme-option]",
            );
            for (const input of themeOptions) {
              input.checked = input.value === inputMode.value;
            }
          }
        });
      }
    </script>

    <style is:global>
      .compare {
        margin: 0;
        font:
          14px system-ui,
          sans-serif;
      }
      .compare-bar {
        position: sticky;
        top: 0;
        z-index: 5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.75rem 1.5rem;
        border-bottom: 1px solid #ccc;
        background: #fff;
        color: #222;
      }
      .compare-bar h1 {
        margin: 0;
        font-size: 1rem;
      }
      .compare-modes {
        display: flex;
        gap: 1rem;
        margin: 0;
        border: 0;
        padding: 0;
      }
      .compare-scroll {
        overflow-x: auto;
      }
      .compare-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        padding-bottom: 5rem;
      }
      .compare-heading {
        margin: 0;
        padding: 0.75rem 1.5rem;
        background: #fff;
        color: #222;
        font-size: 0.9rem;
      }
      .compare-caption {
        grid-column: 1 / -1;
        padding: 1.5rem 1.5rem 0.5rem;
        background: #fff;
        color: #222;
      }
      .compare-caption h3,
      .compare-caption p {
        margin: 0;
      }
      .compare-caption p {
        color: #666;
      }
      .compare-cell {
        min-width: 0;
        padding: 1.5rem;
      }
      .compare-cell-stacked {
        grid-column: 1 / -1;
        padding-block: 1rem;
      }
      .compare-cell-stacked > * {
        width: min(100% - 3rem, 68rem);
        margin-inline: auto;
      }
    </style>
  </body>
</html>
