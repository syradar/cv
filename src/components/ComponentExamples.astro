---
import { examples } from "./examples/registry";
---

<section class="workshop-components" id="components" aria-labelledby="components-heading">
  <header class="workshop-chrome workshop-section-heading">
    <h2 id="components-heading">Component workbench</h2>
    <p>The same pieces used in the CV above. Change an identity to see them together.</p>
  </header>
  {
    examples.map(({ title, description, Component }) => (
      <div class="workshop-example">
        <div class="workshop-chrome workshop-caption">
          <h3>{title}</h3>
          <p>{description}</p>
        </div>
        <Component />
      </div>
    ))
  }
</section>
