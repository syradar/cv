---
interface Props {
  locale?: "en" | "sv";
  scope?: string;
  static?: boolean;
}

const { locale = "en", scope = "site", static: isStatic = false } = Astro.props;
const sv = locale === "sv";
const title = sv ? "Visningsinställningar" : "Display settings";
const identities = [
  {value: "nasa", label: "Modern NASA", detail: sv ? "Precision och energi" : "Precision and energy", sample: "Aa"},
  {value: "editorial", label: "Editorial", detail: sv ? "Typografi och eftertanke" : "Type and thoughtfulness", sample: "Aa"},
  {value: "neobrutalism", label: "Neobrutalism", detail: sv ? "Kontrast och attityd" : "Contrast and attitude", sample: "Aa"},
];
---
<details
  class="ds-controls"
  data-component="appearance-menu"
  data-static={isStatic}
>
  <summary data-appearance-trigger aria-label={title}><span aria-hidden="true">◧</span> {sv ? "Utseende" : "Appearance"}</summary>
  <div class="ds-settings">
    <div class="ds-settings-heading"><strong>{title}</strong><span>{sv ? "Samma innehåll. Nytt uttryck." : "Same content. Different character."}</span></div>
    <fieldset><legend>{sv ? "Identitet" : "Identity"}</legend>
      {identities.map(identity => <label class="ds-preset"><input type="radio" name={`identity-${scope}`} value={identity.value} data-identity-option aria-label={identity.label} /><span class:list={["ds-sample", `ds-sample-${identity.value}`]} aria-hidden="true">{identity.sample}</span><span><strong>{identity.label}</strong><small>{identity.detail}</small></span></label>)}
    </fieldset>
    <fieldset><legend>{sv ? "Färgläge" : "Color mode"}</legend><div class="ds-modes">
      {[{value:"light",label:sv?"Ljust":"Light"},{value:"dark",label:sv?"Mörkt":"Dark"},{value:"system",label:sv?"System":"System"}].map(mode => <label><input type="radio" name={`appearance-${scope}`} value={mode.value} data-theme-option aria-label={mode.label} /><span>{mode.label}</span></label>)}
    </div></fieldset>
    <p class="ds-status" aria-live="polite" data-preference-status></p>
  </div>
</details>
