---
import ThemeMenu from "../ThemeMenu.astro";
import Sun from "astro-heroicons/outline/Sun.astro";
import Moon from "astro-heroicons/outline/Moon.astro";
import english from "../../data/cv.en.json";

interface Props {
  locale: "en" | "sv";
  cv: typeof english;
  static?: boolean;
}

const { locale, cv, static: isStatic = false } = Astro.props;
const languages = [
  { code: "en", label: "English", href: "/" },
  { code: "sv", label: "Svenska", href: "/sv/" },
];
---

<div class="syr-hero-band" data-component="hero-band" data-static={isStatic}>
  <div class="syr-hero-pattern" aria-hidden="true"></div>
  <div class:list={["syr-topbar", { "syr-preference-grid": !isStatic }]} data-component={!isStatic ? "appearance-menu" : undefined}>
    <nav class="syr-segmented syr-squircle" aria-label={cv.labels.language}>
      {
        languages.map((language) =>
          language.code === locale ? (
            <span
              class="syr-squircle"
              aria-current="true"
              lang={language.code}
            >
              {language.label}
            </span>
          ) : (
            <a
              class="syr-squircle"
              href={language.href}
              lang={language.code}
              hreflang={language.code}
            >
              {language.label}
            </a>
          ),
        )
      }
    </nav>
    {isStatic ? <ThemeMenu locale={locale} scope="hero" static /> : <>
      <fieldset class="syr-choice-group syr-identity-segments">
        <legend class="syr-visually-hidden">{locale === "sv" ? "Identitet" : "Identity"}</legend>
        {[{value: "neobrutalism", label: "Neobrutalism"}, {value: "nasa", label: "NASA"}, {value: "editorial", label: "Editorial"}].map(identity => (
          <label>
            <input type="radio" name="identity-hero" value={identity.value} data-identity-option aria-label={identity.label} checked={identity.value === "nasa"} />
            <span>{identity.label}</span>
          </label>
        ))}
      </fieldset>
      <fieldset class="syr-choice-group syr-mode-segments">
        <legend class="syr-visually-hidden">{locale === "sv" ? "Färgläge" : "Color mode"}</legend>
        <label title={cv.labels.themeLight}>
          <input type="radio" name="appearance-hero" value="light" data-theme-option aria-label={cv.labels.themeLight} checked />
          <span><Sun aria-hidden="true" /></span>
        </label>
        <label title={cv.labels.themeDark}>
          <input type="radio" name="appearance-hero" value="dark" data-theme-option aria-label={cv.labels.themeDark} />
          <span><Moon aria-hidden="true" /></span>
        </label>
        <label>
          <input type="radio" name="appearance-hero" value="system" data-theme-option aria-label={cv.labels.themeSystem} />
          <span>{cv.labels.themeSystem}</span>
        </label>
      </fieldset>
      <p class="syr-visually-hidden" aria-live="polite" data-preference-status></p>
    </>}
  </div>
  <slot />
  {!isStatic && <button class="syr-tilt-enable" data-enable-tilt hidden type="button">{locale === "sv" ? "Aktivera lutning" : "Enable tilt"}</button>}
</div>
