---
import DocumentArrowDown from "astro-heroicons/outline/DocumentArrowDown.astro";
interface Props { email: string; contactLabel: string; pdfLabel: string; pdfHref?: string; disabled?: boolean }
const {email, contactLabel, pdfLabel, pdfHref, disabled = false} = Astro.props;
---
<div class="syr-actions">
  <a class="syr-button syr-button-primary syr-squircle" href={`mailto:${email}`}><span class="syr-button-label">{contactLabel}</span></a>
  {pdfHref ? (
    <a class="syr-button syr-button-quiet syr-squircle" href={pdfHref} target="_blank" rel="noopener" type="application/pdf"><span class="syr-button-label">{pdfLabel}</span></a>
  ) : (
  <button class="syr-button syr-button-quiet syr-squircle" type="button" data-print disabled={disabled}><DocumentArrowDown class="syr-button-icon" /><span class="syr-button-label">{pdfLabel}</span></button>
  )}
</div>
<script>
 document.querySelectorAll<HTMLButtonElement>("[data-print]").forEach(button => button.addEventListener("click", () => window.print()));
</script>
