---
import Surface from "./Surface.astro";
interface Props {
  title: string;
  company: string;
  description?: string;
  dates: string;
  nested?: boolean;
}
const { title, company, description, dates, nested = false } = Astro.props;
const Heading = nested ? "h4" : "h3";
---

<Surface as="article" variant={nested ? "nested" : "default"} component="role">
  <p class="syr-meta">{dates}</p>

  <Heading>{title}</Heading>

  <p class="syr-company">
    {company}
  </p>

  {description && <p class="syr-description">{description}</p>}<slot />
</Surface>
