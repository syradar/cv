---
import Actions from "./Actions.astro";

interface Props {
  name: string;
  location: string;
  headline: string;
  email: string;
  contactLabel: string;
  pdfLabel: string;
  pdfHref: string;
  emoji: string;
}

const {
  name,
  location,
  headline,
  email,
  contactLabel,
  pdfLabel,
  pdfHref,
  emoji,
} = Astro.props;
const segmenter = new Intl.Segmenter(undefined, { granularity: "grapheme" });
const words = name.split(" ").map((text) => ({
  text,
  characters: Array.from(segmenter.segment(text), ({ segment }) => segment),
}));
---

<header class="syr-intro" data-component="hero" data-static="true">
  <p class="syr-meta">{location}</p>
  <h1 data-name-heading aria-label={name}>
    <span class="syr-name-plain" aria-hidden="true">{name.split(" ").map((word, index) => <>{index > 0 && <br />}{word}</>)}</span>
    <span class="syr-name-characters" aria-hidden="true">{words.map((word, index) => <>{index > 0 && <br />}<span class="syr-name-line" data-name-line><span class="syr-name-line-reference" data-name-reference>{word.text}</span><span class="syr-name-line-content" data-name-content>{word.characters.map((character) => <span class="syr-name-character">{character}</span>)}</span></span></>)}</span>{" "}<span class="syr-name-emoji" aria-hidden="true">{emoji}</span>
  </h1>

  <p class="syr-headline">{headline}</p>
  <Actions {email} {contactLabel} {pdfLabel} {pdfHref} />
</header>
