---
import Hero from "../system/Hero.astro";
import SectionNav from "../system/SectionNav.astro";
import HeroBand from "../system/HeroBand.astro";
import cv from "../../data/cv.en.json";

---

<HeroBand locale="en" cv={cv} static>
  <div class="syr-hero-inner">
    <Hero
      name={cv.name}
      emoji={cv.labels.nameEmoji}
      location={cv.location}
      headline={cv.headline}
      email={cv.contact.email}
      contactLabel={cv.labels.contact}
      pdfLabel={cv.labels.pdf}
      pdfHref="/cv-david-malmstrom-en.pdf"
    />
    <SectionNav
      label={cv.labels.sections}
      sections={[
        { id: "experience", label: cv.labels.experience },
        { id: "about", label: cv.labels.about },
        { id: "skills", label: cv.labels.skills },
        { id: "education", label: cv.labels.education },
      ]}
    />
  </div>
</HeroBand>
