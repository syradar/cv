---
import Quotation from "./system/Quotation.astro";
import ComponentExamples from "./ComponentExamples.astro";
import Role from "./system/Role.astro";
import Actions from "./system/Actions.astro";
import SkillList from "./system/SkillList.astro";
import Surface from "./system/Surface.astro";
import english from "../data/cv.en.json";
import swedish from "../data/cv.sv.json";
import SiteLayout from "../layouts/SiteLayout.astro";

const showcase = Astro.props.showcase === true;
const locale = Astro.props.locale === "sv" ? "sv" : "en";
const cv = locale === "sv" ? swedish : english;
const dateEnd = (end: string) => (end === "current" ? cv.labels.current : end);
const employmentLabel = (type: string) => {
	switch (type) {
		case "fullTime":
			return cv.labels.fullTime;
		case "partTime":
			return cv.labels.partTime;
		case "freelance":
			return cv.labels.freelance;
		default:
			return cv.labels.contract;
	}
};
const skills = cv.skills.groups.flatMap((group) => group.items);
const structuredData = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: cv.plainName,
	jobTitle: cv.headline,
	description: cv.summary,
	email: cv.contact.email,
	address: {
		"@type": "PostalAddress",
		addressLocality: "Stockholm",
		addressCountry: "SE",
	},
	worksFor: {
		"@type": "Organization",
		name: "DevCore AB",
	},
	sameAs: [cv.contact.github, cv.contact.linkedin],
	knowsAbout: skills,
};
const sections = [
	{ id: "experience", label: cv.labels.experience },
	{ id: "about", label: cv.labels.about },
	{ id: "skills", label: cv.labels.skills },
	{ id: "education", label: cv.labels.education },
];
const otherRoles = [cv.experience.rightGrafiska, cv.experience.freelance];
const [firstName, ...nameRest] = cv.name.split(" ");
const restName = nameRest.join(" ");
---

<SiteLayout locale={locale} cv={cv} showcase={showcase}>
	{showcase && (
		<header slot="workshop" class="workshop-chrome workshop-header">
			<nav aria-label="Workshop">
				<a href="/">David Malmström / CV</a>
				<a href="#main-content">Live composition</a>
				<a href="#components">Components</a>
				{import.meta.env.DEV && <a href="/design-system/compare">Compare identities</a>}
			</nav>
			<p class="workshop-title">One CV. Three identities.</p>
			<p>A component workshop exploring Modern NASA, Editorial, and Neobrutalism. Open Appearance to change the identity or color mode.</p>
		</header>
	)}
	<div slot="hero" class="syr-hero-inner">
		<header class="syr-intro">
			<p class="syr-meta">{cv.location}</p>
			<h1>
				<span>{firstName}</span>
				<span>{restName}</span>
			</h1>
			<p class="syr-headline">{cv.headline}</p>
			<Actions email={cv.contact.email} contactLabel={cv.labels.contact} pdfLabel={cv.labels.pdf} pdfHref={`/cv-david-malmstrom-${locale}.pdf`} />
		</header>

		<nav class="syr-section-nav syr-squircle" aria-label={cv.labels.sections} data-section-nav>
			<span class="syr-nav-glider syr-squircle" aria-hidden="true"></span>
			{sections.map((section) => <a class="syr-squircle" href={`#${section.id}`}>{section.label}</a>)}
		</nav>
	</div>

	<main id="main-content" class="syr-page">
		<section id="experience" class="syr-section" aria-labelledby="experience-heading">
			<h2 id="experience-heading">{cv.labels.experience}</h2>
			<div class="syr-section-content syr-stack">
				<Surface as="article">
					<p class="syr-meta">
						{cv.experience.devcore.dates.start} — {dateEnd(cv.experience.devcore.dates.end)} · {employmentLabel(cv.experience.devcore.employmentType)}
					</p>
					<h3>{cv.experience.devcore.title}</h3>
					<p class="syr-company">{cv.experience.devcore.company}</p>
					<p class="syr-description">{cv.experience.devcore.description}</p>
					<p class="syr-meta syr-client-heading">{cv.labels.clientWork}</p>
					<div class="syr-assignment-list">
						{
cv.experience.devcore.assignments.map((assignment) => (
								<Role
									nested
									title={assignment.title}
									company={assignment.company}
									dates={`${assignment.dates.start} — ${dateEnd(assignment.dates.end)}`}
									description={assignment.highlights ? undefined : assignment.description}
								>
									{assignment.highlights && (
										<ul class="syr-experience-highlights">
											{assignment.highlights.map((highlight) => <li>{highlight}</li>)}
										</ul>
									)}
								</Role>
							))
						}
					</div>
				</Surface>
				{
					otherRoles.map((role) => (
						<Role
							title={role.title}
							company={role.company}
							dates={`${role.dates.start} — ${dateEnd(role.dates.end)} · ${employmentLabel(role.employmentType)}`}
							description={role.description}
						/>
					))
				}
			</div>
		</section>

		<section id="about" class="syr-section" aria-labelledby="about-heading">
			<h2 id="about-heading">{cv.labels.about}</h2>
			<div class="syr-section-content">
				<Surface as="div">
					<p class="syr-about-copy">{cv.summary}</p>
					<ul class="syr-contact-links">
						<li>
							<a href={`mailto:${cv.contact.email}`}>
								<span>{cv.labels.email}</span><span>{cv.contact.email}</span>
							</a>
						</li>
						<li>
							<a href={cv.contact.linkedin} target="_blank" rel="noreferrer">
								<span>{cv.labels.linkedin}</span><span>syradar</span>
							</a>
						</li>
						<li>
							<a href={cv.contact.github} target="_blank" rel="noreferrer">
								<span>{cv.labels.github}</span><span>@syradar</span>
							</a>
						</li>
						<li>
							<a href={cv.contact.curatedReads} target="_blank" rel="noreferrer">
								<span>{cv.labels.curatedReads}</span><span>{cv.labels.readingList}</span>
							</a>
						</li>
					</ul>
				</Surface>
			</div>
		</section>

		<section id="skills" class="syr-section" aria-labelledby="skills-heading">
			<h2 id="skills-heading">{cv.labels.skills}</h2>
			<div class="syr-section-content syr-stack">
				<Surface as="div">
					<div class="syr-skill-groups">
						{
							cv.skills.groups.map((group) => (
								<div>
									<h3 class="syr-group-heading">{group.name}</h3>
									<SkillList items={group.items} />
								</div>
							))
						}
					</div>
				</Surface>
			</div>
		</section>

		<section id="education" class="syr-section" aria-labelledby="education-heading">
			<h2 id="education-heading">{cv.labels.education}</h2>
			<div class="syr-section-content syr-stack">
				<Surface as="article">
					<p class="syr-meta">{cv.education.dates}</p>
					<h3>{cv.education.program}</h3>
					<p class="syr-company">{cv.education.institution}</p>
					<p class="syr-description">{cv.education.details}</p>
				</Surface>
				<Surface as="article">
					<p class="syr-meta">{cv.certification.issued}</p>
					<h3>{cv.certification.name}</h3>
					<p class="syr-company">{cv.certification.issuer} · {cv.labels.certifications}</p>
				</Surface>
			</div>
		</section>

		<section class="syr-section" aria-labelledby="languages-heading">
			<h2 id="languages-heading">{cv.labels.languages}</h2>
			<div class="syr-section-content">
				<Surface as="div">
					<ul class="syr-language-list">
						{
							cv.languages.map((language) => (
								<li>
									<h3>{language.name}</h3>
									<p>{language.proficiency}</p>
								</li>
							))
						}
					</ul>
				</Surface>
			</div>
		</section>

		<section class="syr-section" aria-labelledby="recommendation-heading">
			<h2 id="recommendation-heading">{cv.labels.recommendation}</h2>
			<div class="syr-section-content">
				<Quotation {...cv.recommendation} />
			</div>
		</section>
		<section id="personal" class="syr-section" aria-labelledby="personal-heading">
			<h2 id="personal-heading">{cv.labels.personal}</h2>
			<div class="syr-section-content">
				<Surface as="div">
					<p class="syr-description">
						{cv.personal.interests}{" "}{cv.personal.projectIntro}{" "}
						<a href={cv.personal.projectUrl} target="_blank" rel="noreferrer">{cv.personal.projectName}</a>, {cv.personal.projectDescription}
					</p>
				</Surface>
			</div>
		</section>
		{showcase && <ComponentExamples />}
	</main>
	<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</SiteLayout>

<script>

	const nav = document.querySelector<HTMLElement>("[data-section-nav]");
	const glider = nav?.querySelector<HTMLElement>(".syr-nav-glider");

	const moveGlider = (link: HTMLElement) => {
		if (!nav || !glider) return;
		const navBox = nav.getBoundingClientRect();
		const box = link.getBoundingClientRect();
		glider.style.width = `${box.width}px`;
		glider.style.height = `${box.height}px`;
		glider.style.transform = `translate(${box.left - navBox.left}px, ${box.top - navBox.top}px)`;
		glider.dataset.visible = "true";
	};

	nav?.querySelectorAll<HTMLElement>("a").forEach((link) => {
		link.addEventListener("pointerenter", () => moveGlider(link));
		link.addEventListener("focus", () => moveGlider(link));
	});
	nav?.addEventListener("pointerleave", () => {
		if (glider) glider.dataset.visible = "false";
	});
	nav?.addEventListener("focusout", () => {
		if (glider) glider.dataset.visible = "false";
	});
</script>
