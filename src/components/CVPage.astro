---
import english from "../data/cv.en.json";
import swedish from "../data/cv.sv.json";
import SiteLayout from "../layouts/SiteLayout.astro";

const locale = Astro.props.locale === "sv" ? "sv" : "en";
const cv = locale === "sv" ? swedish : english;
const dateEnd = (end: string) => (end === "current" ? cv.labels.current : end);
const employmentLabel = (type: string) => {
	switch (type) {
		case "fullTime":
			return cv.labels.fullTime;
		case "partTime":
			return cv.labels.partTime;
		case "freelance":
			return cv.labels.freelance;
		default:
			return cv.labels.contract;
	}
};
const skills = cv.skills.groups.flatMap((group) => group.items);
const structuredData = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: cv.plainName,
	jobTitle: cv.headline,
	description: cv.summary,
	email: cv.contact.email,
	address: {
		"@type": "PostalAddress",
		addressLocality: "Stockholm",
		addressCountry: "SE",
	},
	worksFor: {
		"@type": "Organization",
		name: "DevCore AB",
	},
	sameAs: [cv.contact.github, cv.contact.linkedin],
	knowsAbout: skills,
};
const sections = [
	{ id: "experience", label: cv.labels.experience },
	{ id: "about", label: cv.labels.about },
	{ id: "skills", label: cv.labels.skills },
	{ id: "education", label: cv.labels.education },
];
const otherRoles = [cv.experience.rightGrafiska, cv.experience.freelance];
const [firstName, ...nameRest] = cv.name.split(" ");
const restName = nameRest.join(" ");
---

<SiteLayout locale={locale} cv={cv}>
	<div slot="hero" class="syr-hero-inner">
		<header class="syr-intro">
			<p class="syr-meta">{cv.location}</p>
			<h1>
				<span>{firstName}</span>
				<span>{restName}</span>
			</h1>
			<p class="syr-headline">{cv.headline}</p>
			<div class="syr-actions">
				<a class="syr-button syr-button-primary syr-squircle" href={`mailto:${cv.contact.email}`}>
					{cv.labels.contact}
				</a>
				<a
					class="syr-button syr-button-quiet syr-squircle"
					href={`/cv-david-malmstrom-${locale}.pdf`}
					target="_blank"
					rel="noopener"
					type="application/pdf"
				>
					{cv.labels.pdf}
				</a>
			</div>
		</header>

		<nav class="syr-section-nav syr-squircle" aria-label={cv.labels.sections} data-section-nav>
			<span class="syr-nav-glider syr-squircle" aria-hidden="true"></span>
			{sections.map((section) => <a class="syr-squircle" href={`#${section.id}`}>{section.label}</a>)}
		</nav>
	</div>

	<main id="main-content" class="syr-page">
		<section id="experience" class="syr-section" aria-labelledby="experience-heading">
			<h2 id="experience-heading">{cv.labels.experience}</h2>
			<div class="syr-section-content syr-stack">
				<article class="syr-card syr-squircle">
					<p class="syr-meta">
						{cv.experience.devcore.dates.start} — {dateEnd(cv.experience.devcore.dates.end)} · {employmentLabel(cv.experience.devcore.employmentType)}
					</p>
					<h3>{cv.experience.devcore.title}</h3>
					<p class="syr-company">{cv.experience.devcore.company}</p>
					<p class="syr-description">{cv.experience.devcore.description}</p>
					<p class="syr-meta syr-client-heading">{cv.labels.clientWork}</p>
					<div class="syr-assignment-list">
						{
							cv.experience.devcore.assignments.map((assignment) => (
								<article class="syr-nested syr-squircle">
									<p class="syr-meta">
										{assignment.dates.start} — {dateEnd(assignment.dates.end)}
									</p>
									<h4>{assignment.title}</h4>
									<p class="syr-company">{assignment.company}</p>
									{assignment.highlights ? (
										<ul class="syr-experience-highlights">
											{assignment.highlights.map((highlight) => <li>{highlight}</li>)}
										</ul>
									) : (
										<p class="syr-description">{assignment.description}</p>
									)}
								</article>
							))
						}
					</div>
				</article>
				{
					otherRoles.map((role) => (
						<article class="syr-card syr-squircle">
							<p class="syr-meta">
								{role.dates.start} — {dateEnd(role.dates.end)} · {employmentLabel(role.employmentType)}
							</p>
							<h3>{role.title}</h3>
							<p class="syr-company">{role.company}</p>
							<p class="syr-description">{role.description}</p>
						</article>
					))
				}
			</div>
		</section>

		<section id="about" class="syr-section" aria-labelledby="about-heading">
			<h2 id="about-heading">{cv.labels.about}</h2>
			<div class="syr-section-content">
				<div class="syr-card syr-squircle">
					<p class="syr-about-copy">{cv.summary}</p>
					<ul class="syr-contact-links">
						<li>
							<a href={`mailto:${cv.contact.email}`}>
								<span>{cv.labels.email}</span><span>{cv.contact.email}</span>
							</a>
						</li>
						<li>
							<a href={cv.contact.linkedin} target="_blank" rel="noreferrer">
								<span>{cv.labels.linkedin}</span><span>syradar</span>
							</a>
						</li>
						<li>
							<a href={cv.contact.github} target="_blank" rel="noreferrer">
								<span>{cv.labels.github}</span><span>@syradar</span>
							</a>
						</li>
						<li>
							<a href={cv.contact.curatedReads} target="_blank" rel="noreferrer">
								<span>{cv.labels.curatedReads}</span><span>{cv.labels.readingList}</span>
							</a>
						</li>
					</ul>
				</div>
			</div>
		</section>

		<section id="skills" class="syr-section" aria-labelledby="skills-heading">
			<h2 id="skills-heading">{cv.labels.skills}</h2>
			<div class="syr-section-content syr-stack">
				<div class="syr-card syr-card-accent syr-squircle">
					<h3 class="syr-group-heading">{cv.labels.topSkills}</h3>
					<ul class="syr-skill-list syr-skill-list-top">
						{cv.skills.top.map((skill) => <li>{skill}</li>)}
					</ul>
				</div>
				<div class="syr-card syr-squircle">
					<div class="syr-skill-groups">
						{
							cv.skills.groups.map((group) => (
								<div>
									<h3 class="syr-group-heading">{group.name}</h3>
									<ul class="syr-skill-list">
										{group.items.map((skill) => <li>{skill}</li>)}
									</ul>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<section id="education" class="syr-section" aria-labelledby="education-heading">
			<h2 id="education-heading">{cv.labels.education}</h2>
			<div class="syr-section-content syr-stack">
				<article class="syr-card syr-squircle">
					<p class="syr-meta">{cv.education.dates}</p>
					<h3>{cv.education.program}</h3>
					<p class="syr-company">{cv.education.institution}</p>
					<p class="syr-description">{cv.education.details}</p>
				</article>
				<article class="syr-card syr-squircle">
					<p class="syr-meta">{cv.certification.issued}</p>
					<h3>{cv.certification.name}</h3>
					<p class="syr-company">{cv.certification.issuer} · {cv.labels.certifications}</p>
				</article>
			</div>
		</section>

		<section class="syr-section" aria-labelledby="languages-heading">
			<h2 id="languages-heading">{cv.labels.languages}</h2>
			<div class="syr-section-content">
				<div class="syr-card syr-squircle">
					<ul class="syr-language-list">
						{
							cv.languages.map((language) => (
								<li>
									<h3>{language.name}</h3>
									<p>{language.proficiency}</p>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</section>

		<section class="syr-section" aria-labelledby="recommendation-heading">
			<h2 id="recommendation-heading">{cv.labels.recommendation}</h2>
			<div class="syr-section-content">
				<figure class="syr-card syr-squircle syr-recommendation">
					<blockquote lang="en">{cv.recommendation.quote}</blockquote>
					<figcaption>
						<strong>{cv.recommendation.author}</strong>
						<span>{cv.recommendation.role}</span>
						<span>{cv.recommendation.context}</span>
					</figcaption>
				</figure>
			</div>
		</section>
	</main>
	<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
</SiteLayout>

<script>
	const nav = document.querySelector<HTMLElement>("[data-section-nav]");
	const glider = nav?.querySelector<HTMLElement>(".syr-nav-glider");

	const moveGlider = (link: HTMLElement) => {
		if (!nav || !glider) return;
		const navBox = nav.getBoundingClientRect();
		const box = link.getBoundingClientRect();
		glider.style.width = `${box.width}px`;
		glider.style.height = `${box.height}px`;
		glider.style.transform = `translate(${box.left - navBox.left}px, ${box.top - navBox.top}px)`;
		glider.dataset.visible = "true";
	};

	nav?.querySelectorAll<HTMLElement>("a").forEach((link) => {
		link.addEventListener("pointerenter", () => moveGlider(link));
		link.addEventListener("focus", () => moveGlider(link));
	});
	nav?.addEventListener("pointerleave", () => {
		if (glider) glider.dataset.visible = "false";
	});
	nav?.addEventListener("focusout", () => {
		if (glider) glider.dataset.visible = "false";
	});
</script>

<style>
	.syr-page,
	.syr-hero-inner {
		width: min(100% - 3rem, 68rem);
		margin-inline: auto;
	}

	.syr-hero-inner {
		padding-bottom: 2.5rem;
		color: #fff;
	}

	.syr-meta {
		margin: 0;
		color: var(--syr-muted);
		font-family: var(--syr-font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.01em;
	}

	.syr-intro .syr-meta {
		color: rgb(255 255 255 / 85%);
	}

	.syr-intro {
		max-width: 46rem;
		padding-block: 4rem 3.5rem;
	}

	h1 {
		margin: 1rem 0 0;
		font-size: clamp(3rem, 8vw, 6rem);
		font-weight: 650;
		letter-spacing: -0.07em;
		line-height: 1;
	}

	h1 span {
		display: block;
	}

	.syr-headline {
		margin: 1.1rem 0 0;
		color: #fff;
		font-size: 1.3rem;
		font-weight: 580;
		letter-spacing: -0.03em;
	}

	.syr-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.7rem;
		margin-top: 1.8rem;
	}

	.syr-button {
		display: inline-flex;
		min-height: 2.8rem;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		border: 0;
		border-radius: var(--syr-radius-control);
		padding: 0.65rem 1.2rem;
		font: inherit;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
	}

	.syr-button-primary {
		background: #fff;
		color: var(--syr-accent);
	}

	.syr-button {
		transition:
			background-color 160ms ease,
			transform var(--syr-spring-duration) var(--syr-spring);
	}

	.syr-button:hover {
		transform: translateY(-2px);
	}

	.syr-button:active {
		transform: scale(0.96);
	}

	.syr-button-quiet {
		background: color-mix(in srgb, var(--syr-accent) 50%, white);
		color: #1f1f1e;
	}

	.syr-section-nav {
		position: relative;
		display: flex;
		width: fit-content;
		max-width: 100%;
		flex-wrap: wrap;
		gap: 0.2rem;
	}

	.syr-section-nav a {
		position: relative;
		z-index: 1;
		border-radius: var(--syr-radius-inner);
		padding: 0.55rem 1rem;
		color: #fff;
		font-size: 0.88rem;
		font-weight: 600;
		text-decoration: none;
		transition: color 160ms ease;
	}

	.syr-section-nav a:hover,
	.syr-section-nav a:focus-visible {
		color: var(--syr-accent);
	}

	.syr-nav-glider {
		position: absolute;
		top: 0;
		left: 0;
		border-radius: var(--syr-radius-inner);
		background: #fff;
		opacity: 0;
		pointer-events: none;
		transition:
			transform var(--syr-spring-duration) var(--syr-spring),
			width var(--syr-spring-duration) var(--syr-spring),
			height var(--syr-spring-duration) var(--syr-spring),
			opacity 140ms ease;
	}

	.syr-nav-glider[data-visible="true"] {
		opacity: 1;
	}

	.syr-section {
		display: grid;
		grid-template-columns: minmax(10rem, 0.7fr) minmax(0, 2.3fr);
		gap: 1.5rem 2rem;
		padding-top: 4rem;
		scroll-margin-top: 1.5rem;
	}

	.syr-section > h2 {
		align-self: start;
		margin: 0.3rem 0 0;
		font-size: 1.5rem;
		font-weight: 630;
		letter-spacing: -0.05em;
	}

	.syr-section-content {
		min-width: 0;
	}

	.syr-stack {
		display: grid;
		gap: 1rem;
	}

	.syr-card {
		border: 1px solid var(--syr-line);
		border-radius: var(--syr-radius-card);
		padding: clamp(1.2rem, 3vw, 1.9rem);
		background: var(--syr-card);
		box-shadow: var(--syr-elevation-1);
	}

	.syr-nested {
		border: 1px solid var(--syr-line);
		border-radius: var(--syr-radius-nested);
		padding: 1.2rem 1.3rem;
		background: var(--syr-card-nested);
		box-shadow: var(--syr-elevation-2);
	}

	.syr-card h3 {
		margin: 0.55rem 0 0;
		font-size: 1.2rem;
		font-weight: 630;
		letter-spacing: -0.035em;
	}

	.syr-nested h4 {
		margin: 0.5rem 0 0;
		font-size: 1rem;
		font-weight: 620;
		letter-spacing: -0.025em;
	}

	.syr-company {
		margin: 0.25rem 0 0;
		color: var(--syr-muted);
		font-size: 0.9rem;
	}

	.syr-description {
		max-width: 44rem;
		margin: 0.8rem 0 0;
		color: var(--syr-muted);
		font-size: 0.94rem;
		line-height: 1.65;
	}

	.syr-experience-highlights {
		display: grid;
		gap: 0.45rem;
		margin: 0.8rem 0 0;
		padding-left: 1.2rem;
		color: var(--syr-muted);
		font-size: 0.94rem;
		line-height: 1.55;
	}

	.syr-client-heading {
		margin-top: 1.6rem;
	}

	.syr-assignment-list {
		display: grid;
		gap: 0.8rem;
		margin-top: 0.7rem;
	}

	.syr-about-copy {
		max-width: 42rem;
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.65;
		letter-spacing: -0.018em;
	}

	.syr-contact-links {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.6rem;
		margin: 1.6rem 0 0;
		padding: 0;
		list-style: none;
	}

	.syr-contact-links a {
		display: grid;
		min-width: 0;
		gap: 0.25rem;
		border-radius: var(--syr-radius-nested);
		padding: 0.8rem 1rem;
		color: var(--syr-ink);
		font-size: 0.92rem;
		font-weight: 600;
		text-decoration: none;
		transition:
			background-color 160ms ease,
			color 160ms ease,
			transform var(--syr-spring-duration) var(--syr-spring);
	}

	.syr-contact-links a:hover,
	.syr-contact-links a:focus-visible {
		background: var(--syr-accent);
		color: #fff;
		transform: translateY(-2px);
	}

	.syr-contact-links a span:first-child {
		color: var(--syr-muted);
		font-family: var(--syr-font-mono);
		font-size: 0.7rem;
		font-weight: 400;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		transition: color 160ms ease;
	}

	.syr-contact-links a:hover span:first-child,
	.syr-contact-links a:focus-visible span:first-child {
		color: #fff;
	}

	.syr-contact-links a span:last-child {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.syr-group-heading {
		margin: 0 0 0.7rem !important;
		color: var(--syr-muted);
		font-size: 0.85rem !important;
		font-weight: 600 !important;
		letter-spacing: 0 !important;
	}

	.syr-skill-groups {
		display: grid;
		gap: 1.4rem;
		margin-top: 1.7rem;
	}

	.syr-skill-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.6rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.syr-skill-list-top {
		font-size: 1.1rem;
		font-weight: 600;
	}

	.syr-card-accent {
		border-color: var(--syr-accent);
		background: var(--syr-accent);
		color: #fff;
	}

	.syr-card-accent .syr-group-heading {
		color: rgb(255 255 255 / 85%);
	}

	.syr-language-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.syr-language-list h3 {
		margin: 0 !important;
		font-size: 1.05rem !important;
	}

	.syr-language-list p {
		margin: 0.35rem 0 0;
		color: var(--syr-muted);
		font-size: 0.88rem;
		line-height: 1.5;
	}

	.syr-recommendation {
		margin: 0;
	}

	.syr-recommendation blockquote {
		max-width: 48rem;
		margin: 0;
		font-size: clamp(1.2rem, 2.6vw, 1.7rem);
		font-weight: 550;
		letter-spacing: -0.04em;
		line-height: 1.45;
	}

	.syr-recommendation figcaption {
		display: grid;
		gap: 0.15rem;
		margin-top: 1.4rem;
		font-size: 0.85rem;
	}

	.syr-recommendation figcaption span {
		color: var(--syr-muted);
	}

	@media (max-width: 760px) {
		.syr-page {
			width: min(100% - 2rem, 42rem);
		}

		.syr-intro {
			padding-block: 2.5rem 2.5rem;
		}

		.syr-section {
			grid-template-columns: minmax(0, 1fr);
			padding-top: 3rem;
		}

		.syr-contact-links,
		.syr-language-list {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.syr-nav-glider,
		.syr-button,
		.syr-contact-links a {
			transition: none;
		}
	}

	@media print {
		.syr-page {
			width: 100%;
		}

		.syr-hero-inner {
			padding-bottom: 0;
		}

		.syr-intro {
			max-width: none;
			padding-block: 0 0.5rem;
		}

		.syr-hero-inner,
		.syr-intro .syr-meta,
		.syr-headline {
			color: #111;
		}

		h1 {
			font-size: 3rem;
			letter-spacing: -0.05em;
			line-height: 0.95;
		}

		.syr-headline {
			margin-top: 0.4rem;
			font-size: 1rem;
		}

		.syr-section-nav,
		.syr-actions {
			display: none;
		}

		.syr-section {
			grid-template-columns: 7rem minmax(0, 1fr);
			gap: 0.35rem 0.8rem;
			padding-top: 0.75rem;
		}

		.syr-card {
			padding: 0.65rem 0.8rem;
			border: 1px solid var(--syr-line);
			break-inside: auto;
		}

		.syr-nested {
			padding: 0.55rem 0.65rem;
			break-inside: avoid;
		}

		.syr-section > h2 {
			margin-top: 0.1rem;
			font-size: 1rem;
		}

		.syr-card h3 {
			margin-top: 0.2rem;
			font-size: 0.95rem;
		}

		.syr-nested h4 {
			margin-top: 0.2rem;
			font-size: 0.85rem;
		}

		.syr-meta {
			font-size: 0.62rem;
		}

		.syr-company,
		.syr-description,
		.syr-experience-highlights {
			font-size: 0.76rem;
			line-height: 1.3;
		}

		.syr-description,
		.syr-experience-highlights {
			margin-top: 0.35rem;
		}

		.syr-assignment-list,
		.syr-stack,
		.syr-skill-groups {
			gap: 0.4rem;
		}

		.syr-skill-groups {
			margin-top: 0;
		}

