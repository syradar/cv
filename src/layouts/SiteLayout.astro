---
import ThemeMenu from "../components/ThemeMenu.astro";
import english from "../data/cv.en.json";
import "../styles/global.css";

interface Props {
	locale: "en" | "sv";
	cv: typeof english;
}

const { locale, cv } = Astro.props;
const title = `${cv.plainName} — ${cv.headline}`;
const languages = [
	{ code: "en", label: "English", href: "/" },
	{ code: "sv", label: "Svenska", href: "/sv/" },
];
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={cv.summary} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" hreflang="en" href="/" />
		<link rel="alternate" hreflang="sv" href="/sv/" />
		<link rel="alternate" hreflang="x-default" href="/" />
		<title>{title}</title>
		<script is:inline>
			try {
				var saved = localStorage.getItem("syr-theme");
				document.documentElement.dataset.theme =
					saved === "dark" || saved === "system" ? saved : "light";
			} catch (error) {
				document.documentElement.dataset.theme = "light";
			}
		</script>
	</head>
	<body>
		<a class="syr-skip-link" href="#main-content">{cv.labels.skipToContent}</a>
		<div class="syr-site">
			<div class="syr-hero-band">
			<div class="syr-topbar">
				<nav class="syr-segmented syr-squircle" aria-label={cv.labels.language}>
					{
						languages.map((language) =>
							language.code === locale ? (
								<span class="syr-squircle" aria-current="true" lang={language.code}>
									{language.label}
								</span>
							) : (
								<a class="syr-squircle" href={language.href} lang={language.code} hreflang={language.code}>
									{language.label}
								</a>
							),
						)
					}
				</nav>
				<ThemeMenu labels={cv.labels} />
			</div>
			<slot name="hero" />
			</div>
			<slot />
			<footer class="syr-footer">
				<p>© {new Date().getFullYear()} {cv.plainName}</p>
				<a href={`mailto:${cv.contact.email}`}>{cv.contact.email}</a>
			</footer>
		</div>
	</body>
</html>
