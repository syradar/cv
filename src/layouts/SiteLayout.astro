---
import { Font } from "astro:assets";
import HeroBand from "../components/system/HeroBand.astro";
import english from "../data/cv.en.json";
import { createProfileStructuredData } from "../data/structured-data";
import "../styles/global.css";

interface Props {
	locale: "en" | "sv";
	cv: typeof english;
	showcase?: boolean;
}
const { locale, cv, showcase = false } = Astro.props;
const siteOrigin = Astro.site ?? Astro.url;
const pageUrl = new URL(locale === "sv" ? "/sv/" : "/", siteOrigin).href;
const socialImage = new URL(`/og-${locale}.png`, siteOrigin).href;
const socialImageAlt = `${cv.plainName} — ${cv.headline}. ${cv.location}. syradar.se`;
const structuredData = createProfileStructuredData(cv, locale, siteOrigin);
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, "\\u003c");
const title = showcase
	? `Design system — ${cv.plainName}`
	: `${cv.plainName} — ${cv.headline}`;
const description = showcase
	? "A component workshop by David Malmström, exploring three visual identities through one shared design system."
	: cv.summary;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/x-icon" sizes="32x32" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		{
			!showcase && (
				<>
                    <link rel="canonical" href={pageUrl} />
                    <meta property="og:type" content="profile" />
                    <meta property="og:site_name" content={cv.plainName} />
                    <meta property="og:title" content={title} />
                    <meta property="og:description" content={description} />
                    <meta property="og:url" content={pageUrl} />
                    <meta property="og:locale" content={locale === "sv" ? "sv_SE" : "en_GB"} />
                    <meta property="og:locale:alternate" content={locale === "sv" ? "en_GB" : "sv_SE"} />
                    <meta property="og:image" content={socialImage} />
                    <meta property="og:image:type" content="image/png" />
                    <meta property="og:image:width" content="1200" />
                    <meta property="og:image:height" content="630" />
                    <meta property="og:image:alt" content={socialImageAlt} />
                    <meta name="twitter:card" content="summary_large_image" />
                    <meta name="twitter:title" content={title} />
                    <meta name="twitter:description" content={description} />
                    <meta name="twitter:image" content={socialImage} />
                    <meta name="twitter:image:alt" content={socialImageAlt} />
                    <script is:inline type="application/ld+json" set:html={structuredDataJson} />
					<link rel="alternate" hreflang="en" href={new URL("/", siteOrigin)} />
					<link rel="alternate" hreflang="sv" href={new URL("/sv/", siteOrigin)} />
					<link rel="alternate" hreflang="x-default" href={new URL("/", siteOrigin)} />
				</>
			)
		}
		<Font cssVariable="--font-inter" preload={[{ subset: "latin", style: "normal" }]} />
		<Font cssVariable="--font-bricolage-grotesque" />
		<Font cssVariable="--font-junicode" />

		<title>{title}</title>
		<script is:inline>
			try {
				var identity = localStorage.getItem("syr-identity");
				document.documentElement.dataset.identity =
					identity === "editorial" || identity === "neobrutalism"
						? identity
						: "nasa";
				var saved = localStorage.getItem("syr-theme");
				document.documentElement.dataset.theme =
					saved === "dark" || saved === "system" ? saved : "light";
			} catch {
				document.documentElement.dataset.identity = "nasa";
				document.documentElement.dataset.theme = "light";
			}
		</script>
	</head>
	<body class:list={[{ "is-workshop": showcase }]}>
		<a class="syr-skip-link" href="#main-content"
			>{cv.labels.skipToContent}</a
		>
		<slot name="workshop" />
		<div class="syr-site">
			<HeroBand locale={locale} cv={cv}>
				<slot name="hero" />
			</HeroBand>
			<slot />
			<footer class="syr-footer">
				<p>© {new Date().getFullYear()} {cv.plainName}</p>
				<a href={`mailto:${cv.contact.email}`}>{cv.contact.email}</a>
			</footer>
			{import.meta.env.DEV && (
				<nav class="syr-dev-links" aria-label={locale === "sv" ? "Utvecklingsverktyg" : "Development tools"}>
					<a href="/design-system/">{locale === "sv" ? "Designsystem" : "Design system"}</a>
					<a href="/design-system/compare">{locale === "sv" ? "Jämför teman" : "Compare identities"}</a>
				</nav>
			)}
		</div>
		<script>
			import { initializeComponents } from "../scripts/component-runner";
			import { initializePreferenceEffects } from "../scripts/preference-effects";

			const callbacks = initializePreferenceEffects(document);
			initializeComponents(document, callbacks);
		</script>
	</body>
</html>
