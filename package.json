{
  "name": "cv",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.22.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.1 || 26.12.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "10.33.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "assets": "node scripts/generate-brand-assets.mjs",
    "pdf": "astro build && node scripts/generate-pdfs.mjs",
    "pdf:check": "pnpm pdf && git diff --exit-code -- public/*.pdf",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "vp config"
  },
  "dependencies": {
    "@types/node": "^26.6.6",
    "astro": "^7.4.4",
    "astro-heroicons": "2.1.5-1"
  },
  "devDependencies": {
    "node": "^26.12.1",
    "puppeteer": "^25.16.0",
    "vite-plus": "catalog:",
    "wrangler": "^4.156.0"
  }
}